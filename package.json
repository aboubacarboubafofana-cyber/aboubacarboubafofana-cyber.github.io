{
  "name": "nexus",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "api": "cd apps/api && uvicorn main:app --reload --port 8000",
    "web": "pnpm --filter web dev",
    "mobile": "pnpm --filter mobile start"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.5.0"
  }
}